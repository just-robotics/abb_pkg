<?xml version="1.0"?>
<package format="3">
  <name>abb_trajectory_generator</name>
  <version>0.1.0</version>
  <description>Trajectory generation through MoveIt: figures and a mill / laser work cell</description>

  <maintainer email="kondart.dev@gmail.com">Artem Kondratiev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
