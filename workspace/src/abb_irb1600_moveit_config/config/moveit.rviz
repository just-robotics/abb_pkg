Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: abb_work_cell_panel/WorkCellPanel
    Name: WorkCell
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 16
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/MarkerArray
      Name: WorkCell
      Enabled: true
      Topic:
        Value: /work_cell/markers
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Robot Description: robot_description
      Move Group Namespace: ""
      Planning Scene Topic: /monitored_planning_scene
      Planning Request:
        Planning Group: manipulator
        Interactive Marker Size: 0.2
        Query Goal State: false
        Query Start State: false
        # the ABB meshes are orange like MoveIt's default goal color
        Goal State Color: 0; 200; 0
        Goal State Alpha: 0.5
      Planned Path:
        Loop Animation: false
        Show Robot Visual: true
        Show Trail: false
        State Display Time: REALTIME
        Trajectory Topic: /display_planned_path
      # the robot itself is drawn by RobotModel from /tf: the planning scene is published at 4 Hz only
      Scene Robot:
        Show Robot Visual: false
        Show Robot Collision: false
      # the work cell is drawn by the WorkCell markers
      Scene Geometry:
        Show Scene Geometry: false
  Global Options:
    Fixed Frame: world
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point:
        X: 0.4
        Y: 0
        Z: 0.7
      Pitch: 0.4
      Yaw: 0.8
