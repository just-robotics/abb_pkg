<?xml version="1.0"?>
<package format="3">
  <name>abb_irb1600_bringup</name>
  <version>0.1.0</version>
  <description>Hardware side of the ABB IRB 1600-10/1.45: ros2_control (mock or real driver), controllers, robot_state_publisher</description>

  <maintainer email="kondart.dev@gmail.com">Artem Kondratiev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>abb_irb1600_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>mock_components</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
